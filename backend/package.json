    "rotating-file-stream": "^3.2.7",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "stripe": "^20.3.0",
    "tsyringe": "^4.10.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.11"
