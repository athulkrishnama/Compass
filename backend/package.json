    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1"
  },
  "_moduleAliases": {
    "@infrastructure/*": "dist/infrastructure/*",
    "@utils/*": "dist/utils/*",
    "@domain/*": "dist/domain/*",
    "@useCases/*": "dist/application/useCases/*",
    "@config/*": "dist/config/*",
    "@DI/*": "dist/infrastructure/DI/*",
    "@mappers/*": "dist/application/mappers/*",
    "@application/*": "dist/application/*",
    "@presentation/*": "dist/presentation/*"
